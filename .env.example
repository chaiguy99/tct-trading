NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-secret
OWNER_EMAIL=you@example.com
OWNER_PASSWORD_HASH=generate-with-npm-run-auth:hash-password

# Optional hosted journal storage. Leave blank for local SQLite.
# Set this only on the server (never NEXT_PUBLIC_). Supabase transaction-pooler
# connection strings are supported; the app disables prepared statements.
DATABASE_URL=

# Optional OpenAI-compatible journal Q&A. Leave blank to keep it disabled.
# Use HTTPS for remote providers. Loopback HTTP is allowed for local models.
JOURNAL_AI_BASE_URL=
JOURNAL_AI_MODEL=
JOURNAL_AI_API_KEY=
